# FYI: I'm planning on selfhosting this app for myself (on a Raspberry Pi 4B)
# Copy to .env.production on the Pi, then fill in APP_KEY and APP_URL.
# .env.production is gitignored

APP_NAME="Lettuce Eat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Must match the Tailscale hostname exactly, including https://
APP_URL=https://raspberrypi.your-tailnet.ts.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Outside /app because /app/database holds the migrations.
DB_DATABASE=/var/lib/lettuce-eat/database.sqlite
# WAL lets reads proceed during a write, which matters for a long-running server.
DB_JOURNAL_MODE=WAL
DB_BUSY_TIMEOUT=5000

SESSION_DRIVER=database
# A year, in minutes (this is for a single-user app behind a private network)
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
